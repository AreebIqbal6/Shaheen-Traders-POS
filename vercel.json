{
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/(sw\\.js|index\\.html|admin\\.html|manifest\\.webmanifest|manifest-admin\\.json|workbox-.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

